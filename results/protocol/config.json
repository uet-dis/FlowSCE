      "lr": 0.003,
      "dropout": 0.1,
      "layers": 1
    },
    "doh": {
      "kind": "flow",
      "lr": 0.003,
      "dropout": 0.1,
      "layers": 1
    },
    "unsw": {
      "kind": "flow_sage_gate",
      "lr": 0.003,
      "dropout": 0.1,
      "layers": 1
    }
  },
  "env": {
    "python": "3.11.7",
    "torch": "2.2.2+cu121",
    "numpy": "1.26.4",
    "pandas": "3.0.6",
    "sklearn": "1.9.1",
    "device": "cuda",
    "gpu": "NVIDIA RTX 5880 Ada Generation"
  }
