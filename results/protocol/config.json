{
  "datasets": [
    "cic",
    "doh",
    "unsw"
  ],
  "seeds": [
    11,
    23,
    37,
    53,
    71
  ],
  "kinds": [
    "edge",
    "flow",
    "flow_gate"
  ],
  "main": "tuned",
  "n_queries": 100,
